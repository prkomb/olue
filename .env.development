# MongoDB Atlas — Vector Search-capable cluster
MONGODB_URL=your_mongodb_connection_string
MONGODB_DB=your_db_name

# OpenRouter (OpenAI-compatible). Base URL is the SDK base, NOT the chat endpoint.
OPENROUTER_API_KEY=sk-or-v1-lalala
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Lightpanda CDP endpoint (started via docker compose)
LIGHTPANDA_CDP=ws://127.0.0.1:9222,ws://127.0.0.1:9223,ws://127.0.0.1:9224

# Models (open-weight)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536
RANKER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
SUMMARIZER_MODEL=qwen/qwen3-235b-a22b-instruct-2507

# Crawl knobs
CRAWL_CONCURRENCY=3
MAX_PAGES_PER_RUN=50
RUN_SKIP_IF_FRESHER_THAN_HOURS=12
